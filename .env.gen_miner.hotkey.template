# Copy this file once per registered hotkey. Every instance needs a unique PM2
# name, hotkey, axon port, output directory, and state directory.

MINER_PM2_NAME=bitmind-generator-hotkey1

IMAGE_SERVICE=maxcheapai
VIDEO_SERVICE=maxcheapai
MAXCHEAPAI_API_KEY=
MAXCHEAPAI_SPEED=slow
MAXCHEAPAI_POLL_INTERVAL=10
MAXCHEAPAI_POLL_TIMEOUT=1800
MAXCHEAPAI_MAX_RETRIES=3
MAXCHEAPAI_RETRY_DELAY=10

BT_CHAIN_ENDPOINT=wss://entrypoint-finney.opentensor.ai:443
BT_NETUID=34
BT_WALLET_NAME=miner1
BT_WALLET_HOTKEY=hotkey1

BT_AXON_PORT=8093
BT_AXON_IP=0.0.0.0
# BT_AXON_EXTERNAL_IP=your.public.ip

MINER_MAX_CONCURRENT_TASKS=5
MINER_WORKER_THREADS=5
MINER_TASK_TIMEOUT=1800
MINER_SAVE_LOCALLY=true
MINER_OUTPUT_DIR=./miner_generated_content/hotkey1
MINER_STATE_DIR=./miner_state/hotkey1

BT_LOGGING_LEVEL=INFO
AUTO_UPDATE=false
